@model InventoryDetailsViewModel
@{
    ViewData["Title"] = Model.Inventory.Title;
}

<section class="details-shell">
    <partial name="_DetailsHero" model="Model" />
    <partial name="_DetailsTabs" model="Model" />

    <div class="tab-content details-tab-content">
        <partial name="_DetailsItemsTab" model="Model" />
        <partial name="_DetailsDiscussionTab" model="Model" />

        @if (Model.Access.CanManage)
        {
            <partial name="_DetailsSettingsTab" model="Model" />
            <partial name="_DetailsCustomIdTab" model="Model" />
            <partial name="_DetailsFieldsTab" model="Model" />
            <partial name="_DetailsAccessTab" model="Model" />
            <partial name="_DetailsApiTab" model="Model" />
        }

        <partial name="_DetailsStatsTab" model="Model" />
        <partial name="_DetailsExportTab" model="Model" />
    </div>
</section>

@section Scripts {
    <script src="~/js/inventory-details.js" asp-append-version="true"></script>
}
