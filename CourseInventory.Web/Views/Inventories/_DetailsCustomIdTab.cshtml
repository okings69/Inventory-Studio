@model InventoryDetailsViewModel
@inject IUiTextService T
@{ var inventory = Model.Inventory; }
        <section class="tab-pane fade" id="customid">
            <div class="panel details-panel"
                 data-customid-builder
                 data-inventory-id="@inventory.Id"
                 data-reorder-url="@Url.Action("Reorder", "CustomId")">
                <div class="panel-header">
                    <div><h2>@T["CustomId"]</h2><p>@T["DetailsCustomIdText"]</p></div>
                    <code id="customIdPreview" class="custom-id-preview" data-customid-preview>@Model.CustomIdPreview</code>
                </div>
                @if (Model.Access.CanManage)
                {
                    <form asp-controller="CustomId" asp-action="Add" method="post" class="details-form" data-customid-add-form>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="inventoryId" value="@inventory.Id" />
                        <div class="row g-2">
                            <div class="col-md-4">
                                <div class="custom-id-help-input">
                                    <select class="form-select" name="elementType" data-customid-type-select>
                                        @foreach (var option in Html.GetEnumSelectList<CustomIdElementType>())
                                        {
                                            var typeHelpKey = $"CustomIdType{option.Text}Help";
                                            var formatHelp = option.Text is "DateTime" or "Sequence"
                                                ? T[typeHelpKey]
                                                : T["CustomIdFormatDefaultHelp"];
                                            <option value="@option.Value"
                                                    data-type-help="@T[typeHelpKey]"
                                                    data-format-help="@formatHelp">@option.Text</option>
                                        }
                                    </select>
                                    <button class="btn btn-outline-secondary custom-id-help-button"
                                            type="button"
                                            data-bs-toggle="popover"
                                            data-bs-trigger="focus"
                                            data-bs-placement="top"
                                            data-customid-type-help
                                            title="@T["CustomIdTypeHelpLabel"]"
                                            data-bs-content="@T["CustomIdTypeFixedTextHelp"]"
                                            aria-label="@T["TypeHelp"]">?</button>
                                </div>
                            </div>
                            <div class="col-md-3"><input class="form-control" name="fixedValue" placeholder="@T["FixedValue"]" /></div>
                            <div class="col-md-3">
                                <div class="custom-id-help-input">
                                    <input class="form-control" name="format" placeholder="@T["Format"]" />
                                    <button class="btn btn-outline-secondary custom-id-help-button"
                                            type="button"
                                            data-bs-toggle="popover"
                                            data-bs-trigger="focus"
                                            data-bs-placement="top"
                                            data-customid-format-help
                                            title="@T["CustomIdFormatHelpLabel"]"
                                            data-bs-content="@T["CustomIdFormatDefaultHelp"]"
                                            aria-label="@T["FormatHelp"]">?</button>
                                </div>
                            </div>
                            <div class="col-md-2"><button class="btn btn-outline-primary w-100">@T["AddElement"]</button></div>
                        </div>
                        <div class="form-text mt-2">@T["CustomIdFormatHint"]</div>
                    </form>
                }
                <div class="builder-list" data-customid-list>
                    @if (!inventory.CustomIdElements.Any())
                    {
                        <div class="empty-state">@T["CustomIdPreview"]</div>
                    }
                    @foreach (var element in inventory.CustomIdElements.OrderBy(e => e.SortOrder))
                    {
                        <article class="builder-row"
                                 data-customid-row
                                 data-id="@element.Id"
                                 data-type="@element.ElementType"
                                 data-fixed="@element.FixedValue"
                                 data-format="@element.Format"
                                 draggable="@(Model.Access.CanManage ? "true" : "false")">
                            <div>
                                @if (Model.Access.CanManage)
                                {
                                    <button class="btn btn-sm btn-outline-secondary me-2"
                                            type="button"
                                            data-customid-drag-handle
                                            aria-label="Drag Custom ID element">Drag</button>
                                }
                                <strong>@element.ElementType</strong><span>@element.FixedValue @element.Format</span>
                            </div>
                            @if (Model.Access.CanManage)
                            {
                                <form asp-controller="CustomId" asp-action="Delete" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@element.Id" />
                                    <input type="hidden" name="inventoryId" value="@inventory.Id" />
                                    <button class="btn btn-sm btn-outline-danger">@T["Remove"]</button>
                                </form>
                            }
                        </article>
                    }
                </div>
            </div>
        </section>
