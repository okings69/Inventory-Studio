@model SalesforceProfileFormViewModel
@{
    ViewData["Title"] = "Send profile to Salesforce";
}

<section class="profile-hero mb-4">
    <div class="profile-identity">
        <div class="profile-hero-avatar">SF</div>
        <div>
            <p class="eyebrow mb-2">CRM integration</p>
            <h1>Send profile to Salesforce</h1>
            <p class="text-body-secondary mb-0">
                Create a Salesforce Account for the company and a linked Contact for @Model.UserName.
            </p>
        </div>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Profile" asp-action="Index">Back to profile</a>
</section>

<div class="row justify-content-center">
    <section class="col-xl-8">
        <div class="panel profile-panel">
            <div class="panel-header">
                <div>
                    <h2>Salesforce details</h2>
                    <p>Only profile data and the fields below are sent. Salesforce credentials stay on the server.</p>
                </div>
            </div>

            <form asp-action="Salesforce" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <input asp-for="UserId" type="hidden" />
                <input asp-for="UserName" type="hidden" />
                <input asp-for="UserEmail" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="col-md-8">
                    <label asp-for="CompanyName" class="form-label"></label>
                    <input asp-for="CompanyName" class="form-control" autocomplete="organization" />
                    <span asp-validation-for="CompanyName" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="JobTitle" class="form-label"></label>
                    <input asp-for="JobTitle" class="form-control" autocomplete="organization-title" />
                    <span asp-validation-for="JobTitle" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" autocomplete="address-level2" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Country" class="form-label"></label>
                    <input asp-for="Country" class="form-control" autocomplete="country-name" />
                    <span asp-validation-for="Country" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <div class="col-12 d-flex flex-wrap gap-2 justify-content-end">
                    <a class="btn btn-outline-secondary" asp-controller="Profile" asp-action="Index">Cancel</a>
                    <button type="submit" class="btn btn-primary">Create Account and Contact</button>
                </div>
            </form>
        </div>
    </section>
</div>

@if (ViewData["SalesforceError"] is string salesforceError)
{
    <div class="toast-container position-fixed top-0 end-0 p-3 inventory-toast-container">
        <div class="toast inventory-toast text-bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true" data-salesforce-toast>
            <div class="d-flex">
                <div class="toast-body">@salesforceError</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const salesforceToast = document.querySelector('[data-salesforce-toast]');
        if (salesforceToast && window.bootstrap) {
            new bootstrap.Toast(salesforceToast, { delay: 5200 }).show();
        }
    </script>
}
